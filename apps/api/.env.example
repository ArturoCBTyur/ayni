# ---------------------------------------------------------------------------
# Trazabilidad Radical - API. Copiar a .env y completar.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Base de datos
# OJO: el PostgreSQL 18 de esta maquina escucha en el puerto 5433, no 5432.
DATABASE_URL="postgresql://tr_app:CAMBIAR@localhost:5433/trazabilidad_radical?schema=public"

# Sesion (RNF-02). Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambiar-en-produccion-access
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=cambiar-en-produccion-refresh
JWT_REFRESH_TTL=604800
COOKIE_SECRET=cambiar-en-produccion-cookie

# TOTP (RNF-02: MFA obligatorio para ONG, auditor y admin)
TOTP_EMISOR="Trazabilidad Radical"

# Frontend permitido por CORS
CORS_ORIGENES=http://localhost:5000,http://localhost:8080

# Almacenamiento (ADR-003). disco | s3
STORAGE_DRIVER=disco
STORAGE_DIR=../../storage
STORAGE_URL_SECRET=cambiar-firma-de-urls
STORAGE_URL_TTL=900

# Pasarela de pago (ADR: adaptador). fake | culqi
PASARELA_DRIVER=fake
PASARELA_COMISION_PORCENTAJE=3.44
PASARELA_COMISION_FIJA=1.00
PASARELA_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/pasarela
PASARELA_WEBHOOK_SECRET=cambiar-hmac-webhook

# Servicio de comprobantes (RF-DE-03). fake | sunat
CPE_DRIVER=fake

# Motor de verificacion (el seam de AIni). reglas-v0 | aini
VERIFICACION_DRIVER=reglas-v0
AINI_URL=http://localhost:8000

# Correo (ADR-004). En desarrollo se usa Ethereal si no hay credenciales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE="Trazabilidad Radical <no-responder@trazabilidadradical.pe>"
