# ---------------------------------------------------------------------------
# Ayni - API. Copiar a .env y completar.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Base de datos
# OJO: el PostgreSQL 18 de esta maquina escucha en el puerto 5433, no 5432.
DATABASE_URL="postgresql://tr_app:CAMBIAR@localhost:5433/trazabilidad_radical?schema=public"

# Sesion (RNF-02). Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambiar-en-produccion-access
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=cambiar-en-produccion-refresh
JWT_REFRESH_TTL=604800
COOKIE_SECRET=cambiar-en-produccion-cookie

# TOTP (RNF-02: MFA obligatorio para ONG, auditor y admin)
TOTP_EMISOR="Ayni"

# Frontend permitido por CORS
CORS_ORIGENES=http://localhost:5000,http://localhost:8080

# Almacenamiento (ADR-003). disco | s3
STORAGE_DRIVER=disco
STORAGE_DIR=../../storage
STORAGE_URL_SECRET=cambiar-firma-de-urls
STORAGE_URL_TTL=900

# Pasarela de pago (ADR: adaptador). fake | culqi
PASARELA_DRIVER=fake
PASARELA_COMISION_PORCENTAJE=3.44
PASARELA_COMISION_FIJA=1.00
PASARELA_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/pasarela
PASARELA_WEBHOOK_SECRET=cambiar-hmac-webhook

# Servicio de comprobantes (RF-DE-03). fake | sunat
CPE_DRIVER=fake

# Motor de verificacion (el seam de AIni). reglas-v0 | aini
#   reglas-v0  motor determinista en el propio backend, sin IA
#   aini       servicio de analisis en apps/aini (scikit-learn + spaCy)
# Con "aini" y sin AINI_URL la API arranca igual, con el motor de reglas y un
# aviso: dejar la plataforma sin verificacion seria peor que verificar con reglas.
VERIFICACION_DRIVER=reglas-v0
AINI_URL=http://127.0.0.1:8000
# AINI_TOKEN=  # se exige si el servicio lo tiene definido en su entorno
AINI_TIMEOUT_MS=20000

# Donde alcanza AIni a esta API para descargar los comprobantes que va a leer.
# El lector recibe una URL firmada, no bytes: AIni corre en otro proceso y no
# tiene acceso al disco del backend. En local el valor por defecto sirve; en un
# despliegue donde los dos servicios no comparten host, esto DEBE apuntar a la
# URL publica de la API o el OCR no podra descargar nada y todo gasto quedara
# con "no se pudo leer el comprobante".
API_URL_PUBLICA=http://127.0.0.1:3000

# Correo (ADR-004). En desarrollo se usa Ethereal si no hay credenciales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE="Ayni <no-responder@ayni.pe>"
