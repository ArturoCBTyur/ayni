__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# El modelo entrenado es un artefacto, no fuente: se regenera con
# `python -m entrenamiento.entrenar` y pesa. Su ficha SI se versiona, porque
# documenta con que se entreno el que este corriendo.
modelos/*.joblib

# Fotos reales del banco de evaluacion. Una boleta trae el nombre y a veces el
# DNI del cliente (Ley N.o 29733): las imagenes se guardan fuera del repo y
# aqui solo se versiona su anotacion, con el hash (evaluacion/campo.jsonl).
evaluacion/campo/

# El modelo de escena (CLIP en ONNX, ~600 MB) tampoco es fuente: se trae con
# `python -m entrenamiento.escena --descargar`. Los vectores de las frases y la
# ficha (modelos/escena.textos.npz, escena.ficha.json) SI se versionan.
modelos/escena/

# Fotos del banco de escenas: se descargan con `python -m evaluacion.escena
# --descargar` a partir del manifiesto versionado (evaluacion/escena.jsonl).
evaluacion/escena/
